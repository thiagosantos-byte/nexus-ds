# The API queries with the authenticated user's JWT and a publishable key.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# For local use only; production may use Vercel OIDC. Never use VITE_ here.

# Exact frontend origins separated by commas. Never use a wildcard.
FRONTEND_ORIGINS=https://SEU-FRONTEND.exemplo
NODE_ENV=production

# Nexus IA (opcional). Compatível com a API da OpenAI e provedores equivalentes.
# Sem a chave, a Nexus IA responde no modo local, usando apenas os dados do
# contexto institucional já autorizado ao usuário.
NEXUS_AI_API_KEY=
NEXUS_AI_BASE_URL=https://api.openai.com/v1
NEXUS_AI_MODEL=gpt-4o-mini
